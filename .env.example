# 이 파일은 실제 값을 포함하지 않는다. 복사해서 .env.local 로 사용한다.
# .env.local 은 .gitignore 에 의해 커밋되지 않는다.

# ---- Supabase ----
# Supabase 프로젝트 설정 > API 에서 확인
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 서버 전용 키. NEXT_PUBLIC_ 접두사를 붙이거나 클라이언트 번들에 노출하지 않는다.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Google 로그인 도메인 제한 ----
# 학교 Google Workspace 도메인 (예: school.hs.kr). 로그인 허용 도메인 검증에 사용 (Phase 2).
GOOGLE_WORKSPACE_DOMAIN=

# Google OAuth Client ID/Secret은 Supabase Dashboard > Authentication > Providers > Google
# 에서 직접 등록한다. 앱 런타임 코드가 이 값을 직접 읽지는 않지만, 프로젝트에서 사용하는
# 크리덴셜을 추적하기 위해 이름만 기록해둔다.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ---- Google Sheets 연동 (서비스 계정, Phase 3/8) ----
GOOGLE_SHEETS_SERVICE_ACCOUNT_EMAIL=
# 개인 키의 개행 문자는 \n 으로 escape하여 한 줄 문자열로 저장한다.
GOOGLE_SHEETS_SERVICE_ACCOUNT_PRIVATE_KEY=
# [학생명단]/[학급정보]/[사용자정보]/[AI교육현황] 4개 탭이 있는 스프레드시트 ID
GOOGLE_SHEETS_SPREADSHEET_ID=
